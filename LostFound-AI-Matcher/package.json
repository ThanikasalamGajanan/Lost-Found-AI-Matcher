{
  "name": "lost-found-ai-matcher",
  "version": "1.0.0",
  "private": true,
  "description": "Lost and Found AI Matching App - Intelligent item matching with verification workflows",
  "scripts": {
    "install:all": "npm --prefix backend install; npm --prefix frontend install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "test": "npm --prefix backend run test",
    "db:migrate": "npm --prefix backend run migrate",
    "db:seed": "npm --prefix backend run seed"
  }
}