# ===========================================
# Lost & Found AI Matcher - Environment Config
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Backend API ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
API_URL=http://localhost:4000/api

# --- Database ---
# Supabase Postgres via the IPv4 POOLER (direct db.xxx.supabase.co is IPv6-only).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- OpenAI (LLM + Embeddings + Vision) ---
OPENAI_API_KEY=sk-your-openai-key

# --- Email (Resend / SendGrid) ---
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@yourdomain.com

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Auth ---
JWT_SECRET=replace-with-a-strong-random-secret
